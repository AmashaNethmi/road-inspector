{
  "venvPath": "backend",
  "venv": ".venv",
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/.python",
    "**/dist",
    "**/dataset"
  ],
  "extraPaths": [
    "backend",
    "backend/.venv/Lib/site-packages"
  ],
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "reportAttributeAccessIssue": "none",
  "reportGeneralTypeIssues": "none"
}
